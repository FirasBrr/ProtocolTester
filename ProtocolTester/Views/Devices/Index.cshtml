@model List<DeviceJson>

@{
    ViewData["Title"] = "Modbus Devices";
    var deviceTypeLookup = ViewBag.DeviceTypeLookup as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-server"></i> Modbus Devices</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Device
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <h5><i class="fas fa-info-circle"></i> No devices configured</h5>
            <p>Click "Add New Device" to create your first Modbus TCP device.</p>
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Device Name</th>
                            <th>Type</th>
                            <th>IP Address</th>
                            <th>Port</th>
                            <th>Slave ID</th>
                            <th>Protocol</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in Model)
                        {
                            var displayName = deviceTypeLookup.ContainsKey(device.DeviceTypeName)
                                ? deviceTypeLookup[device.DeviceTypeName]
                                : device.DeviceTypeName;

                            <tr id="row-@device.Id">
                                <td>
                                    <strong>@device.Name</strong>
                                </td>
                                <td>@displayName</td>
                                <td>@(device.ModbusTcpParameters?.IpAddress ?? "N/A")</td>
                                <td>@(device.ModbusTcpParameters?.Port ?? 0)</td>
                                <td>@(device.ModbusTcpParameters?.SlaveId ?? device.ModbusSerialParameters?.SlaveId ?? 0)</td>
                                <td>
                                    @if (device.Protocol == 1)
                                    {
                                        <span class="badge bg-primary">TCP</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">RTU</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-success test-btn"
                                                data-id="@device.Id"
                                                data-name="@device.Name"
                                                data-ip="@(device.ModbusTcpParameters?.IpAddress ?? "")"
                                                data-port="@(device.ModbusTcpParameters?.Port ?? 502)"
                                                data-slave="@(device.ModbusTcpParameters?.SlaveId ?? device.ModbusSerialParameters?.SlaveId ?? 1)"
                                                data-timeout="@(device.ModbusTcpParameters?.ReadTimeout ?? device.ModbusSerialParameters?.ReadTimeout ?? 1000)">
                                            <i class="fas fa-vial"></i> Test All Registers
                                        </button>
                                        <button class="btn btn-outline-dark detailed-test-btn"
                                                data-id="@device.Id"
                                                data-name="@device.Name"
                                                data-ip="@(device.ModbusTcpParameters?.IpAddress ?? "")"
                                                data-port="@(device.ModbusTcpParameters?.Port ?? 502)"
                                                data-slave="@(device.ModbusTcpParameters?.SlaveId ?? device.ModbusSerialParameters?.SlaveId ?? 1)"
                                                data-timeout="@(device.ModbusTcpParameters?.ReadTimeout ?? device.ModbusSerialParameters?.ReadTimeout ?? 1000)"
                                                title="Detailed diagnostic test with live log, timing, and root-cause analysis">
                                            <i class="fas fa-microscope"></i> Detailed Test
                                        </button>
                                        <button class="btn btn-outline-info inspect-btn"
                                                data-id="@device.Id"
                                                data-name="@device.Name"
                                                data-device='@Json.Serialize(device)'>
                                            <i class="fas fa-eye"></i> Inspect
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ============================ -->
<!-- PARTIAL VIEWS (Modals)      -->
<!-- ============================ -->
@await Html.PartialAsync("_TestStandard")
@await Html.PartialAsync("_TestDetailed")
@await Html.PartialAsync("_InspectModal")

<!-- ============================ -->
<!-- SCRIPTS                     -->
<!-- ============================ -->
@section Scripts {
    <script src="~/js/modbus-tester.js"></script>
}